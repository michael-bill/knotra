    "/runs/{runId}/events": {
      "get": {
        "operationId": "watch_run_events",
        "summary": "Durable SSE with replay, event IDs and heartbeat comments",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE frames: id equals Event.id; data is Event JSON; heartbeat <=30s; frame <=256KiB.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "id: e1\ndata: {\"id\":\"e1\",\"runId\":\"r1\",\"at\":\"2026-10-01T00:00:00Z\",\"type\":\"run.updated\",\"message\":\"Started\"}\n\n"
              }
            }
          },
          "default": {
            "description": "Run or retained cursor unavailable; never silently skip a history gap.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
