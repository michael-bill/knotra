{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "name",
    "monthly_cost",
    "setup_days",
    "control",
    "support",
    "quotes",
    "limitations"
  ],
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "monthly_cost": { "type": "number", "minimum": 0 },
    "setup_days": { "type": "integer", "minimum": 1 },
    "control": { "enum": ["full", "theme", "limited"] },
    "support": { "enum": ["managed", "community", "internal"] },
    "quotes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 8, "maxLength": 200 }
    },
    "limitations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
