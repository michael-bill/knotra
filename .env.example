# Local settings for future integration tests; the engine is not implemented yet.
# Copy to .env.local and fill in your own key. Never commit .env.local.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
# This endpoint requires reasoning; 128 tokens was insufficient in the smoke test.
OPENROUTER_MAX_TOKENS=1024
